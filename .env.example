# ─────────────────────────────────────────────
#  LLM Provider  (anthropic | ollama | openai)
# ─────────────────────────────────────────────
LLM_PROVIDER=ollama

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (optional fallback)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────────
#  Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_db
# For Docker Compose use: postgresql+asyncpg://postgres:postgres@db:5432/lenny_db

# ─────────────────────────────────────────────
#  Vector Store (ChromaDB)
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=lenny_transcripts

# ─────────────────────────────────────────────
#  Embeddings
# ─────────────────────────────────────────────
# sentence-transformers model for local embeddings (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─────────────────────────────────────────────
#  Application
# ─────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────
#  Security
# ─────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
